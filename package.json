{
  "name": "ices-monorepo",
  "private": true,
  "packageManager": "bun@1.1.34",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ices/web",
    "dev:api": "turbo run dev --filter=@ices/api",
    "build": "turbo run build",
  "lint": "turbo run lint",
  "format": "turbo run format",
  "test": "turbo run test",
    "clean": "turbo run clean --parallel",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo && bun install"
  },
  "devDependencies": {
    "turbo": "^2.1.1",
    "typescript": "^5.6.3",
    "@biomejs/biome": "^1.8.3"
  }
}
